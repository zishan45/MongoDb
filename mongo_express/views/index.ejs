<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whatsapp</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h3>All Chats</h3>
     
    <form method="GET" action="/chats/new">
        <button>New Chat</button>
    </form>
    <br>
    <% for (let chat of chats){ %>
       <div class="chat">
          <p>From: <i><%= chat.from %> </i> </p>
          <div class="msg">
            <p>Message: <%= chat.msg %></p>
          </div>
            <form method="GET" action="/chats/<%= chat._id %>/edit">
                <button class="btn">Edit Msg</button>
            </form>
            <br>
             <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE">
                <button class="btn">Delete chat</button>
            </form>
          <p>To: <i><%= chat.to %> </i> </p>
          <hr>
          <p> <%= chat.createdAt.toString().split(" ") [4] %> </p>
          <p> <%= chat.createdAt.toString().split(" ").slice(0, 4).join(" ") %> </p>
       </div>
       <br>
       <br>
    <% } %>
</body>
</html>